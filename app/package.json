{
  "name": "speed-l",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:ci": "ng lint --output-file eslint_report.json --format json",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:ci": "wireit",
    "e2e:server": "wireit"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "wireit": {
    "e2e:ci": {
      "command": "playwright test",
      "dependencies": [
        "e2e:server"
      ]
    },
    "e2e:server": {
      "command": "ng serve",
      "service": {
        "readyWhen": {
          "lineMatches": ".*localhost*"
        }
      }
    }
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.4.0",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^28.0.0",
    "playwright-ng-schematics": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8",
    "wireit": "^0.14.13"
  }
}
